APP_NAME=treatment-plus-fe
APP_ENV=local
APP_URL=http://localhost:3000

# Go API — only the Next server talks to this. The browser never does.
API_URL=http://localhost:8080
API_TIMEOUT_MS=8000

# Phase 1 — session cookie stays on the Next origin (BFF).
SESSION_COOKIE=tp_session
SESSION_SECURE=false
